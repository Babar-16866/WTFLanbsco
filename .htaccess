# Extensionless URLs — serve page.php when /page is requested
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /page.php → /page (hide extension)
  # Skip POST — 301 turns POST into GET and breaks form endpoints (405)
  RewriteCond %{REQUEST_METHOD} !POST [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteCond %{THE_REQUEST} !\s/+send-mail\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Map extensionless path to .php if that file exists
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
