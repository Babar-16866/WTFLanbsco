{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{assets/**,.git/**}"
    }
  },
  "routes": [
    {
      "src": "/(?!send-mail\\.php$)(.+)\\.php",
      "methods": ["GET", "HEAD"],
      "status": 301,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "/(assets/.+|sitemap\\.xml)",
      "headers": { "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400" },
      "dest": "/$1"
    },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
